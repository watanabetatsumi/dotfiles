# ~/.zshrc（macOS / Linux・WSL 共通。install.sh がリンクを張る）
# マシン固有の設定や秘密の環境変数は ~/.zshrc.local に書く（git 管理外）

# ---------- OS ごとの準備 ----------
case "$(uname -s)" in
  Darwin)
    [[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv zsh)"
    export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
    alias clipcopy='pbcopy'
    ;;
  Linux)
    if grep -qi microsoft /proc/version 2>/dev/null; then   # WSL
      alias clipcopy='clip.exe'
      export BROWSER=wslview                                 # xdg-open などが Windows 側のブラウザを開く
    else
      alias clipcopy='xclip -selection clipboard'
    fi
    ;;
esac

export PATH="$HOME/.local/bin:$PATH"
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# ---------- oh-my-zsh ----------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
zstyle ':omz:update' mode auto
plugins=(git)
[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# ---------- asdf（0.16 以降はシムに PATH を通すだけ）----------
export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"

# ---------- fzf ----------
if fzf --zsh >/dev/null 2>&1; then
  source <(fzf --zsh)                                         # fzf 0.48 以降
elif [[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]]; then
  source /usr/share/doc/fzf/examples/key-bindings.zsh         # Ubuntu の apt 版（0.44）
  [[ -f /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh
fi
export FZF_DEFAULT_OPTS='--height 40% --reverse --border'

# ---------- コマンド ----------
command -v lsd >/dev/null 2>&1 && alias ls='lsd'

# Google Cloud SDK（Mac は ~/google-cloud-sdk、Ubuntu は apt で入れると PATH に入る）
[[ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]] && . "$HOME/google-cloud-sdk/path.zsh.inc"
[[ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]] && . "$HOME/google-cloud-sdk/completion.zsh.inc"

# ---------- worktree ----------
command -v wtp >/dev/null 2>&1 && eval "$(wtp shell-init zsh)"

# policy-cloud の devtools（wta / mk）
if [[ -d "$HOME/projects/policy-cloud/devtools" ]]; then
  export PATH="$HOME/projects/policy-cloud/devtools/bin:$PATH"
  source "$HOME/projects/policy-cloud/devtools/shell/wta.zsh"
fi

[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
